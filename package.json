{
  "name": "ecoplate-edge",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-mediapipe-assets.mjs",
    "dev": "vite",
    "docs": "node scripts/render-docs.mjs",
    "build": "npm run docs && tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc -b --pretty false && vitest run",
    "evaluate": "vitest run src/evaluation"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@mediapipe/tasks-vision": "1.0.1"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "marked": "18.0.11",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "4.0.18"
  }
}
